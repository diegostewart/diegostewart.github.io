---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { SITE } from '../site.config';
import { getPosts, getTags, url } from '../lib/posts';

const posts = await getPosts();
const recent = posts.slice(0, SITE.recentCount);
const tags = getTags(posts).slice(0, 12);
---

<Base>
  <section class="intro container" data-enter aria-labelledby="intro-h">
    <p class="kicker enter-up">{SITE.role}</p>
    <h1 id="intro-h" class="intro__title enter-up">{SITE.author}</h1>
    <p class="intro__lead enter-up">{SITE.intro}</p>
    <div class="btn-row enter-up">
      <a class="btn btn--primary" href={url('about/')}>About me</a>
      <a class="btn btn--secondary" href={url('blog/')}>Read my writing</a>
    </div>
    <div class="enter-up"><ProfileLinks /></div>
  </section>

  <section class="block container" aria-labelledby="recent-h">
    <div class="block__head">
      <h2 id="recent-h" class="block__title">Recent writing</h2>
      {posts.length > recent.length && <a class="more" href={url('blog/')}>All {posts.length} posts</a>}
    </div>
    {recent.length > 0 ? <PostList posts={recent} /> : <p class="empty">No posts yet. Add a Markdown file to <code>src/content/blog/</code>.</p>}
  </section>

  {
    tags.length > 0 && (
      <section class="block container" aria-labelledby="topics-h">
        <div class="block__head">
          <h2 id="topics-h" class="block__title">Topics</h2>
          <a class="more" href={url('tags/')}>All tags</a>
        </div>
        <ul class="tag-list">
          {tags.map((t) => (
            <li>
              <a class="tag" href={url(`tags/${t.slug}/`)}>
                {t.name}<span class="tag__count">{t.posts.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
