---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();

// Group by year, newest year first (posts are already newest first).
const years = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.pubDate.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), post]);
}
---

<Base title="Writing" description={`All ${posts.length} posts by the author, newest first.`} current="blog">
  <header class="page-head container">
    <h1 class="page-title">Writing</h1>
    <p class="page-lead">{posts.length} {posts.length === 1 ? 'post' : 'posts'}, newest first.</p>
  </header>
  <div class="container">
    {
      [...years].map(([year, list]) => (
        <section class="year" aria-labelledby={`y-${year}`}>
          <h2 id={`y-${year}`} class="year__title">{year}</h2>
          <PostList posts={list} showYear={false} />
        </section>
      ))
    }
    {posts.length === 0 && <p class="empty">No posts yet.</p>}
  </div>
</Base>
