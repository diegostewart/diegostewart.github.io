---
import Base from '../../layouts/Base.astro';
import { getPosts, getTags, url } from '../../lib/posts';

const tags = getTags(await getPosts());
---

<Base title="Tags" description="Every tag used on this blog, with the number of posts under each." current="tags">
  <section class="page-head">
    <div class="wrap">
      <h1>Tags</h1>
      <p class="lead">{tags.length} {tags.length === 1 ? 'tag' : 'tags'}. Pick one to see its posts.</p>
    </div>
  </section>
  <div class="wrap page-body">
    {
      tags.length > 0 ? (
        <ul class="tag-cloud">
          {tags.map((t) => (
            <li>
              <a class="tag tag--lg" href={url(`tags/${t.slug}/`)}>
                {t.name} <span class="tag__count">{t.posts.length}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No tags yet. Add <code>tags: [...]</code> to a post’s frontmatter.</p>
      )
    }
  </div>
</Base>
