---
import Base from '../../layouts/Base.astro';
import { getPosts, getTags, url } from '../../lib/posts';

const tags = getTags(await getPosts());
---

<Base title="Tags" description="Every tag used on this blog, with the number of posts under each." current="tags">
  <header class="page-head container">
    <h1 class="page-title">Tags</h1>
    <p class="page-lead">{tags.length} {tags.length === 1 ? 'tag' : 'tags'} across all posts.</p>
  </header>
  <div class="container">
    {
      tags.length > 0 ? (
        <ul class="tag-index">
          {tags.map((t) => (
            <li>
              <a href={url(`tags/${t.slug}/`)}>
                <span class="tag-index__name">{t.name}</span>
                <span class="tag-index__count">{t.posts.length} {t.posts.length === 1 ? 'post' : 'posts'}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No tags yet. Add <code>tags: [...]</code> to a post’s frontmatter.</p>
      )
    }
  </div>
</Base>
