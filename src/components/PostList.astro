---
import { formatShortDate, postUrl, readingMinutes, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Heading level for each post title, so the page outline stays in order. */
  level?: 'h2' | 'h3';
  /** Show the description under each title. */
  descriptions?: boolean;
  /** Show the year in the date (off inside a year-grouped archive). */
  showYear?: boolean;
}

const { posts, level = 'h3', descriptions = true, showYear = true } = Astro.props;
const Heading = level;
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li class="post-row">
        <a class="post-row__link" href={postUrl(post)}>
          <span class="post-row__main">
            <Heading class="post-row__title">
              {post.data.title}
              {post.data.draft && <span class="badge">Draft</span>}
            </Heading>
            {descriptions && <span class="post-row__desc">{post.data.description}</span>}
          </span>
          <span class="post-row__meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatShortDate(post.data.pubDate, showYear)}</time>
            {descriptions && <span class="post-row__read">{readingMinutes(post.body)} min</span>}
          </span>
        </a>
      </li>
    ))
  }
</ol>
